[43.26, "o", "\u001b[0m\r\n\u001b[0m$ \u001b[0mwhich gcloud google-cloud-sdk python3 pip3 2>/dev/null; ls ~/.config/gcloud 2>/dev/null; echo \"---\"; ls /usr/lib/google-cloud-sdk 2>/dev/null || echo \"no sdk dir\"\r\n/usr/bin/python3\r\n---\r\nno sdk dir\r\n\u001b[0m\r\n"]
[44.06, "o", "\u001b[93m\u001b[1m! \u001b[0mpermission requested: external_directory (/etc/*); auto-rejecting\r\n"]
[44.103, "o", "\u001b[0m\u2717 \u001b[0mcat /etc/os-release 2>/dev/null | head -5; echo \"---\"; which apt apt-get snap 2>/dev/null; echo \"---\"; pip3 --version 2>/dev/null failed\r\n\u001b[91m\u001b[1mError: \u001b[0mThe user rejected permission to use this specific tool call.\r\n"]
