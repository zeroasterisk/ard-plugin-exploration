[1.542, "o", "\u001b[1;33m\u25ba Addressing the Detractor Myth:\u001b[0m\r\n"]
[1.542, "o", "  \u001b[2;37m\"Why publish an ARD catalog if it's useless without a Google Cloud account?\"\u001b[0m\r\n\r\n"]
[6.039, "o", "\u001b[1;32m\u25ba The Multi-Tier Reality:\u001b[0m Capabilities exist on an \u001b[1;36mAuth & Friction Spectrum\u001b[0m:\r\n"]
[6.039, "o", "  \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\n"]
[6.039, "o", "  \u2502 \u001b[1;32mTier 0: Pure Public / Zero Auth\u001b[0m  \u279c Skills, zero-trust architectures, offline SQL recipes   \u2502\r\n"]
[6.039, "o", "  \u2502 \u001b[1;36mTier 1: Developer Keys\u001b[0m          \u279c Gemini API (AI Studio), Developer Knowledge MCP Docs    \u2502\r\n"]
[6.039, "o", "  \u2502 \u001b[1;35mTier 2: User Workspace OAuth\u001b[0m    \u279c Gmail, Google Drive, Google Sheets MCPs                 \u2502\r\n"]
[6.039, "o", "  \u2502 \u001b[1;33mTier 3: Google Cloud ADC & SA\u001b[0m   \u279c BigQuery, GCS, Cloud Run, GKE, Cloud SQL Managed MCPs   \u2502\r\n"]
[6.039, "o", "  \u2502 \u001b[1;31mTier 4: Enterprise Attestation\u001b[0m  \u279c Chronicle SecOps, Security Command Center, VPC-SC       \u2502\r\n"]
[6.039, "o", "  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n\r\n"]
[13.107, "o", "\u001b[1;34m\u25ba User Experience Pillars:\u001b[0m\r\n"]
[13.107, "o", "  \u001b[1;37m1. Zero Friction for Non-GCP Users\u001b[0m \u279c Pure offline skills work immediately with 0 prompts.\r\n"]
[13.107, "o", "  \u001b[1;37m2. Strict Opt-Out Control\u001b[0m          \u279c Users can say 'never show cloud tools' & it is remembered.\r\n"]
