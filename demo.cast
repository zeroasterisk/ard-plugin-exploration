[198.903, "o", "\r\n\u001b[?2004l\r"]
[198.96, "o", "================================================================================\r\n\ud83d\ude80 LAUNCHING PODMAN CONTAINER E2E EXPERIMENT SUITE\r\n\u2022 Container Runtime: podman\r\n\u2022 Image:             docker.io/library/python:3.13-slim\r\n\u2022 Target Repo:       /usr/local/google/home/alanblount/Workspaces/open-source/ard-plugin-exploration\r\n================================================================================\r\n\r\n================================================================================\r\n"]
[198.961, "o", "\ud83e\uddea EXPERIMENT 1: Pure Open Source Developer (Zero Auth / Offline)\r\n================================================================================\r\n"]
[200.873, "o", "\u2022 Returned 10 results in clean container.\r\n\u2022 Top Result: Google Cloud Well-Architected Security Skill (Tier 0) -> Status: ready\r\n\u2705 Experiment 1 Passed: Zero-auth user received immediate offline skills without nags.\r\n\r\n================================================================================\r\n\ud83e\uddea EXPERIMENT 2: Strict Opt-Out Developer (Explicit Anti-Cloud Preference)\r\n================================================================================\r\n"]
[202.76, "o", "\u2022 Query: 'bigquery analytical database query' (Opt-Out Active)\r\n\u2022 Results returned: 5\r\n\u2022 Discovered IDs: ['urn:ai:google.com:skills:bigquery-guidelines', 'urn:ai:google.com:skills:well-architected-cost-optimization', 'urn:ai:google.com:skills:well-architected-performance-efficiency', 'urn:ai:google.com:skills:database-design', 'urn:ai:google.com:mcp:developer-knowledge']\r\n\u2705 Experiment 2 Passed: Strict opt-out guaranteed 0 GCP account items returned.\r\n\r\n================================================================================\r\n"]
[202.76, "o", "\ud83e\uddea EXPERIMENT 3: Progressive Onboarding (Cloud intent without auth)\r\n================================================================================\r\n"]
[204.692, "o", "\u2022 BigQuery MCP Status: needs_onboarding\r\n\u2022 Action Suggestion:   Requires GCP auth (`gcloud auth application-default login`). Fallback: `urn:ai:google.com:skills:bigquery-guidelines`.\r\n\u2022 Fallback Skill:      urn:ai:google.com:skills:bigquery-guidelines\r\n\u2022 Onboarding Message:  Requires GCP credentials. Run `gcloud auth application-default login` or activate free tier.\r\n"]
[204.692, "o", "\u2022 Free Tier:           True (1TB of free query processing and 10GB of free storage per month.)\r\n\u2705 Experiment 3 Passed: Non-intrusive onboarding plan and fallback provided.\r\n"]
[204.692, "o", "\r\n================================================================================\r\n\ud83e\uddea EXPERIMENT 4: Authenticated Enterprise Developer (Service Account Active)\r\n================================================================================\r\n"]
[206.569, "o", "\u2022 BigQuery MCP Auth Ready:      True (Status: ready)\r\n\u2022 Cloud Storage MCP Auth Ready: True (Status: ready)\r\n"]
[206.57, "o", "\u2705 Experiment 4 Passed: Authenticated environment marked cloud tools as ready with zero prompts.\r\n"]
[206.57, "o", "\r\n================================================================================\r\n\ud83e\uddea EXPERIMENT 5: Free AI Developer (Gemini API Key, No GCP Account)\r\n"]
[206.57, "o", "================================================================================\r\n"]
[208.51, "o", "\u2022 Gemini Skill: Gemini API Structured Outputs & Tool Calling Skill -> Status: ready (Auth Ready: True)\r\n\u2705 Experiment 5 Passed: Gemini API key recognized; Tier 1 tool ready without GCP account.\r\n\r\n================================================================================\r\n\ud83e\uddea EXPERIMENT 6: Stateless Read-Only Container Environment\r\n================================================================================\r\n"]
[209.871, "o", "\u2022 Returned 10 results on strict --read-only container filesystem.\r\n\u2705 Experiment 6 Passed: Stateless read-only sandbox executed flawlessly.\r\n\r\n================================================================================\r\n\ud83d\udcca E2E PODMAN EXPERIMENT SUMMARY: 6 PASSED, 0 FAILED\r\n================================================================================\r\n"]
[209.883, "o", "\u001b[?2004h\u001b[01;32mdeveloper@workstation\u001b[00m:\u001b[01;34m~/ard-project\u001b[00m$ "]
