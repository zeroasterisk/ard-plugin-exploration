[52.031, "o", "\u001b[0m\u2699 \u001b[0mard-google-discovery_ard_auth_status Unknown\r\n"]
[54.412, "o", "I'll set your GCP discovery preference to opt-out, and record that decision for the services you've declined\r\n"]
[54.566, "o", "\u001b[0m\u2699 \u001b[0mard-google-discovery_ard_set_preference {\"mode\":\"opt_out\"}\r\n"]
[54.566, "o", "\u001b[0m\u2699 \u001b[0mard-google-discovery_ard_record_decision {\"service_identifier\":\"urn:ai:google.com:mcp:bigquery\",\"decision\":\"declined\"}\r\n"]
[56.482, "o", "Done. GCP discovery is set to opt-out mode, so no GCP/cloud tools will be surfaced. Let me know what you'd like to work on.\r\n"]
