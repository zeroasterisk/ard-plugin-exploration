uery-guidelines\"\r\n  },\r\n  {\r\n    \"identifier\": \"urn:ai:google.com:mcp:cloud-sql\",\r\n    \"displayName\": \"Google Cloud SQL Managed MCP Server\",\r\n    \"type\": \"application/mcp-server-card+json\",\r\n    \"description\": \"Manage, connect to, and query PostgreSQL, MySQL, and SQL Server managed database instances in Google Cloud.\",\r\n    \"url\": \"https://cloudsql.mcp.google.com/server.json\",\r\n    \"tags\": [\r\n      \"mcp\",\r\n      \"database\",\r\n      \"sql\",\r\n      \"postgres\",\r\n      \"mysql\",\r\n      \"cloud-sql\",\r\n      \"auth:gcp-account\",\r\n      \"tier:3\"\r\n    ],\r\n "]
