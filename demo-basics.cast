[14.494, "o", "\u001b[0m\r\n\u001b[0m$ \u001b[0mls -la /workspace/ard-plugin-exploration && echo \"---\" && ls -la /workspace/ard-plugin-exploration/.opencode 2>/dev/null; ls -la ~/.config/opencode 2>/dev/null\r\ntotal 244\r\ndrwxr-xr-x    8 root     root          4096 Aug 12 20:39 .\r\ndrwxr-xr-x    1 root     root          4096 Aug 12 20:58 ..\r\ndrwxr-xr-x    4 root     root          4096 Aug 12 20:58 .config\r\ndrwxr-xr-x    6 root     root          4096 Aug 12 20:44 .git\r\n-rw-r--r--    1 root     root            54 Aug 12 16:23 .gitignore\r\n-rw-r--r--    1 root     root          1090 Aug 12 16:19 Dockerfile\r\n-rw-r--r--    1 root     root          7151 Aug 12 20:43 README.md\r\n-rw-r--r--    1 root     root         37410 Aug 12 20:42 ai-catalog.json\r\n-rwxr-xr-x    1 root     root          1687 Aug 12 17:31 ask\r\n-rw-r--r--    1 root     root         53173 Aug 12 20:43 demo-basics.cast\r\n-rw-r--r--    1 root     root         66198 Aug 12 18:15 demo.cast\r\n-rw-r--r--    1 root     root          3556 Aug 11 15:40 demo_player.html\r\n-rw-r--r--    1 root     root         21585 Aug 12 20:43 index.html\r\n-rw-r--r--    1 root     root           289 Aug 12 20:38 opencode.json\r\ndrwxr-xr-x    5 root     root          4096 Aug 11 13:13 plugin\r\ndrwxr-xr-x    3 root     root          4096 Aug 12 20:36 scripts\r\ndrwxr-xr-x    3 root     root          4096 Aug 11 13:43 src\r\ndrwxr-xr-x    3 root     root          4096 Aug 11 13:44 tests\r\n---\r\ntotal 8\r\ndrwxr-xr-x    2 root     root          4096 Aug 10 06:03 .\r\ndrwxr-xr-x    3 root     root          4096 Aug 10 06:03 ..\r\n\u001b[0m\r\n"]
